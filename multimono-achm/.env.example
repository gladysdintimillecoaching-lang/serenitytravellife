# ── Multimono ACHM : configuration ──
# Copiez ce fichier en .env et complétez-le.

PORT=3000
NODE_ENV=production
# Adresse publique de l'application (utilisée dans les liens des emails)
APP_URL=https://multimono.mon-club.fr

# Secret pour signer les liens des emails (chaîne aléatoire longue)
APP_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Compte du gérant (créé au premier démarrage)
ADMIN_LOGIN=eric
ADMIN_PASSWORD=choisissez-un-mot-de-passe-solide
ADMIN_EMAIL=eric@exemple.fr

# Envoi des emails (SMTP) — ex. Brevo, Mailjet, OVH, Gmail (mot de passe d'application)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Multimono ACHM <no-reply@mon-club.fr>

# Marge (minutes) après le rappel H-24 pendant laquelle une annulation reste « à temps »
REMINDER_GRACE_MINUTES=60

# Emplacement de la base de données (dossier à sauvegarder)
# DB_FILE=./data/multimono.db
